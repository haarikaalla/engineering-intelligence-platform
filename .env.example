# Copy to .env and fill in. Never commit the real .env.
POSTGRES_PASSWORD=change-me-strong
NEO4J_PASSWORD=change-me-strong

# Optional: require X-API-Key on the backend (the frontend proxy injects it server-side)
API_KEY=

# LLM provider: auto | openai | anthropic | none
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Embeddings: auto (OpenAI if key set) | openai | local
EMBEDDING_PROVIDER=auto

# Private repositories (fallback token; users can also pass a one-time token per request)
GITHUB_TOKEN=
# JSON list; add your GitHub Enterprise / GitLab self-managed host here
ALLOWED_GIT_HOSTS=["github.com","gitlab.com","bitbucket.org"]

# Ingestion limits
CLONE_DEPTH=500
MAX_FILE_SIZE_KB=512
MAX_FILES=60000
PIPELINE_WORKERS=2

# Dependency vulnerability lookups (OSV.dev). Disable in air-gapped environments.
ENABLE_OSV=true
